#pragma config(Sensor, S1,     sensorEsquerda, sensorSONAR)
#pragma config(Sensor, S2,     sensorMeio,     sensorSONAR)
#pragma config(Sensor, S3,     sensorDireita,  sensorSONAR)
#pragma config(Motor,  motorA,          motorEsq,      tmotorNXT, PIDControl, driveLeft, encoder)
#pragma config(Motor,  motorB,          motorDir,      tmotorNXT, PIDControl, driveRight, encoder)
#pragma config(Motor,  motorC,          motorArma,     tmotorNXT, openLoop, encoder)
//*!!Code automatically generated by 'ROBOTC' configuration wizard               !!*//

const int DISTANCIA_ALVO = 40;

task main()
{

	wait1Msec(5000);

	 // liga a arma e fica girando constantemente
	 motor[motorArma] = 100;

	 // estratégia inicial
	 // gira para a direita durante 1 seg
	 motor[motorEsq] = 100;
	 motor[motorDir] = -100;
	wait1Msec(1000);
	// andar para a frente durante 2 seg
	motor[motorEsq] = 100;
	motor[motorDir] = 100;
	wait1Msec(2000);
	// gira para a esquerda durante 2 seg
	motor[motorEsq] = -100;
	motor[motorDir] = 100;
	wait1Msec(2000);
	// para os motores
	motor[motorEsq] = 0;
	motor[motorDir] = 0;

	while(true)
	{
		// 1° condição: oponente detectado pelo sensor do MEIO
		// avança com força total para empurrar
		if(SensorValue[sensorMeio] < DISTANCIA_ALVO)
		{
			motor[motorEsq] = 100;
			motor[motorDir] = 100;
		}

		// 2° condição: oponente detectado apenas pela ESQUERDA
		// gira rápido para a esquerda para alinhar
		else if(SensorValue[sensorEsquerda] < DISTANCIA_ALVO)
		{
			motor[motorEsq] = -100;
			motor[motorDir] = 100;
		}

		// 3° condição: Oponente detectado apenas pela DIREITA
		// gira rápido para a direita para alinhar
		else if(SensorValue[sensorDireita] < DISTANCIA_ALVO)
		{
			motor[motorEsq] = 100;
			motor[motorDir] = -100;
		}

		// 4° condição: nenhum sensor detectou nada
		// gira no próprio eixo para procurar o adversário
		else
		{
			motor[motorEsq] = 100;
			motor[motorDir] = -100;
		}

		wait1Msec(20);
	}
}

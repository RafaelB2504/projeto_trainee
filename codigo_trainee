#pragma config(Sensor, S1,     esquerdo,       sensorSONAR)
#pragma config(Sensor, S2,     direito,        sensorSONAR)
#pragma config(Motor,  motorB,          direita,       tmotorNXT, PIDControl, reversed, driveRight, encoder)
#pragma config(Motor,  motorC,          esquerda,      tmotorNXT, PIDControl, reversed, driveLeft, encoder)
//*!!Code automatically generated by 'ROBOTC' configuration wizard               !!*//


task main()
{
	wait1Msec(5000);
  int sonarEsquerdo, sonarDireito;
	while(true)
	{
		sonarEsquerdo = SensorValue[esquerdo];
		sonarDireito = SensorValue[direito];

		if(sonarDireito>50 && sonarEsquerdo>50)
		{
			motor[direita] = -100;
			motor[esquerda] = 100;
		}

				else(sonarDireito<50 || sonarEsquerdo<50)
		{
				sonarEsquerdo = SensorValue[S1];
				sonarDireito = SensorValue[S2];
				motor[direita] = 100;
				motor[esquerda] = 100;
		}
	}

}


#pragma config(Sensor, S1,     esquerdo,       sensorSONAR)
#pragma config(Sensor, S2,     direito,        sensorSONAR)
#pragma config(Motor,  motorA,          direita,       tmotorNXT, PIDControl, encoder)
#pragma config(Motor,  motorB,          rampa,         tmotorNXT, PIDControl, reversed, encoder)
#pragma config(Motor,  motorC,          esquerda,      tmotorNXT, PIDControl, encoder)
//*!!Code automatically generated by 'ROBOTC' configuration wizard               !!*//

task main()
{
	wait1Msec(5000);
	
	nMotorEncoder[rampa] = 0;
			motor[rampa] = 50;
			wait1Msec(500);
			motor[rampa] = 0;
	
	int sonarEsquerdo, sonarDireito;
	while(true)
	{
		sonarEsquerdo = SensorValue[S1];
		sonarDireito = SensorValue[S2];

		if(sonarDireito>30 && sonarEsquerdo>30)
		{
			motor[direita] = -80;
			motor[esquerda] = 80;
		}

		else
		{
			sonarEsquerdo = SensorValue[S1];
			sonarDireito = SensorValue[S2];
			motor[direita] = 100;
			motor[esquerda] = 100;
		}
	}

}

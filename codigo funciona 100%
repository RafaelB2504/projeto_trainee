#pragma config(Sensor, S1,     sensorEsquerda, sensorSONAR)
#pragma config(Sensor, S2,     sensorMeio,     sensorSONAR)
#pragma config(Sensor, S3,     sensorDireita,  sensorSONAR)
#pragma config(Motor,  motorA,          motorEsquerda, tmotorNXT, PIDControl, reversed, driveLeft, encoder)
#pragma config(Motor,  motorB,          motorDireita,  tmotorNXT, PIDControl, reversed, driveRight, encoder)
#pragma config(Motor,  motorC,           ,             tmotorNXT, openLoop)
//*!!Code automatically generated by 'ROBOTC' configuration wizard               !!*//

task main()
{
	//espera obrigatoria 5 segundos
    wait1Msec(5000);
  //define a distancia
    const int DISTANCIA_ALVO = 40;

    //estrategia inicial
    //"sairBorda" + "olezinho"
    motor[motorEsquerda] = 70;
    motor[motorDireita] = 70;
    wait1Msec (400);
    motor[motorEsquerda] = 90;
    motor[motorDireita]  = 20;
    wait1Msec(600);
    motor[motorEsquerda] = 70;
    motor[motorDireita] = 70;
    wait1Msec(400);
    motor[motorEsquerda] = 20;
    motor[motorDireita] = 90;
    wait1Msec(800);
    
   // para os motores
		motor[motorEsquerda] = 0;
		motor[motorDireita] = 0;
		wait1Msec(500);

    // estrategia de combate
    while(true)
    {
       
        if (SensorValue[sensorMeio] < DISTANCIA_ALVO) //caso A: alvo no centro
        {

            motor[motorEsquerda] = 100;
            motor[motorDireita]  = 100;
           
        }
        else if (SensorValue[sensorEsquerda] < DISTANCIA_ALVO) //caso B: alvo a esquerda
        {
        	  //gira enquanto a leitura lateral for maior que a central

          	motor[motorEsquerda] = -70;
            motor[motorDireita]  = 70;
         


        }
        else if (SensorValue[sensorDireita] < DISTANCIA_ALVO) //caso C: alvo a  direita
        {
          // gira enquanto a leitura lateral for maior que a central

            motor[motorEsquerda] = 70;
            motor[motorDireita]  = -70;
           
       }
        else //perdeu de vista: procura o alvo girando ate algum sonar detectar
        {
   				  motor[motorEsquerda] = 100;
            motor[motorDireita]  = -100;
        }

        // Delay de estabilizacao dos sensores
        wait1Msec(20);
    }
}
